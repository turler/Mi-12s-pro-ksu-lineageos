diff --git a/block/ioprio.c b/block/ioprio.c
index b5a942519a79..16e3d6f97c3b 100644
--- a/block/ioprio.c
+++ b/block/ioprio.c
@@ -66,6 +66,10 @@ int ioprio_check_cap(int ioprio)
 	return 0;
 }
 
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+extern bool susfs_is_priority_uid_filtered(uid_t uid);
+#endif // #ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+
 SYSCALL_DEFINE3(ioprio_set, int, which, int, who, int, ioprio)
 {
 	struct task_struct *p, *g;
@@ -113,8 +117,15 @@ SYSCALL_DEFINE3(ioprio_set, int, which, int, who, int, ioprio)
 			if (!who)
 				user = current_user();
 			else
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+			{
+				if (current_uid().val >= 10000 && susfs_is_priority_uid_filtered(uid.val))
+					break;
 				user = find_user(uid);
-
+			}
+#else
+				user = find_user(uid);
+#endif // #ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
 			if (!user)
 				break;
 
@@ -249,8 +260,15 @@ SYSCALL_DEFINE2(ioprio_get, int, which, int, who)
 			if (!who)
 				user = current_user();
 			else
+#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
+			{
+				if (current_uid().val >= 10000 && susfs_is_priority_uid_filtered(uid.val))
+					break;
 				user = find_user(uid);
-
+			}
+#else
+				user = find_user(uid);
+#endif // #ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER
 			if (!user)
 				break;
 
