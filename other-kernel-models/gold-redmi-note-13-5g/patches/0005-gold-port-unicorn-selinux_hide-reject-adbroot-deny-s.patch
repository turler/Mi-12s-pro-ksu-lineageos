From 8f9433315fabecf1f62abe2d9a89954a0e634b4f Mon Sep 17 00:00:00 2001
From: flamint <minhdaochi504@gmail.com>
Date: Thu, 19 Nov 2026 22:45:34 +0700
Subject: [PATCH 5/5] gold: port unicorn selinux_hide (reject adbroot, deny
 :su:/:adbroot: access, stack_buf)

---
 drivers/kernelsu/feature/selinux_hide.c | 150 +++++++++---------------
 1 file changed, 55 insertions(+), 95 deletions(-)

diff --git a/drivers/kernelsu/feature/selinux_hide.c b/drivers/kernelsu/feature/selinux_hide.c
index a86016b36ff6..54a63a3a1338 100644
--- a/drivers/kernelsu/feature/selinux_hide.c
+++ b/drivers/kernelsu/feature/selinux_hide.c
@@ -180,6 +180,10 @@ static ssize_t my_write_access(struct file *file, char *buf, size_t size)
     }
 
     security_compute_av_user_with_policy(backup_sepolicy, ssid, tsid, tclass, &avd);
+    if (unlikely(strstr(tcon, ":su:") || strstr(scon, ":su:") ||
+                 strstr(tcon, ":adbroot:") || strstr(scon, ":adbroot:"))) {
+        avd.allowed = 0;
+    }
 
     // stock reads 1; a loader load_policy may have bumped the backup before we load
     avd.seqno = 1;
@@ -617,171 +621,127 @@ void ksu_selinux_hide_drop_backup_if_unused()
 /*
  * Caveat:  Mutates scontext.
  */
-static int string_to_context_struct(struct policydb *pol, struct policydb *orig_pol, struct sidtab *sidtabp,
-                                    struct sidtab *orig_sidtabp, char *scontext, char *orig_scontext,
-                                    struct context *ctx, struct context *orig_ctx, u32 def_sid, int *orig_rc_p)
+static int string_to_context_struct_single(struct policydb *pol, struct sidtab *sidtabp, char *scontext,
+                                           struct context *ctx, u32 def_sid)
 {
-    struct role_datum *role, *orig_role;
-    struct type_datum *typdatum, *orig_typdatum;
-    struct user_datum *usrdatum, *orig_usrdatum;
-    char *scontextp, *orig_scontextp, *p, *orig_p, oldc, orig_oldc;
-    int rc = 0, orig_rc = 0;
+    struct role_datum *role;
+    struct type_datum *typdatum;
+    struct user_datum *usrdatum;
+    char *scontextp, *p, oldc;
+    int rc = -EINVAL;
 
     context_init(ctx);
-    context_init(orig_ctx);
-
-    /* Parse the security context. */
-
-    orig_rc = rc = -EINVAL;
-    scontextp = scontext;
-    orig_scontextp = orig_scontext;
 
     /* Extract the user. */
+    scontextp = scontext;
     p = scontextp;
-    orig_p = orig_scontextp;
-    while (*p && *p != ':') {
+    while (*p && *p != ':')
         p++;
-        orig_p++;
-    }
-
     if (*p == 0)
         goto out;
-
-    *orig_p++ = *p++ = 0;
+    *p++ = 0;
 
     usrdatum = symtab_search(&pol->p_users, scontextp);
-    orig_usrdatum = symtab_search(&orig_pol->p_users, orig_scontextp);
     if (!usrdatum)
         goto out;
-
     ctx->user = usrdatum->value;
-    if (orig_usrdatum)
-        orig_ctx->user = orig_usrdatum->value;
 
     /* Extract role. */
     scontextp = p;
-    orig_scontextp = orig_p;
-    while (*p && *p != ':') {
+    while (*p && *p != ':')
         p++;
-        orig_p++;
-    }
-
     if (*p == 0)
         goto out;
-
-    *orig_p++ = *p++ = 0;
+    *p++ = 0;
 
     role = symtab_search(&pol->p_roles, scontextp);
-    orig_role = symtab_search(&orig_pol->p_roles, orig_scontextp);
     if (!role)
         goto out;
     ctx->role = role->value;
-    if (orig_role)
-        orig_ctx->role = orig_role->value;
 
     /* Extract type. */
     scontextp = p;
-    orig_scontextp = orig_p;
-    while (*p && *p != ':') {
+    while (*p && *p != ':')
         p++;
-        orig_p++;
-    }
     oldc = *p;
-    orig_oldc = *orig_p;
-    *orig_p++ = *p++ = 0;
+    *p++ = 0;
+
+    if (unlikely(!strcmp(scontextp, "adbroot")))
+        goto out;
 
     typdatum = symtab_search(&pol->p_types, scontextp);
-    orig_typdatum = symtab_search(&orig_pol->p_types, orig_scontextp);
     if (!typdatum || typdatum->attribute)
         goto out;
-
     ctx->type = typdatum->value;
-    if (orig_typdatum && !orig_typdatum->attribute)
-        orig_ctx->type = orig_typdatum->value;
 
     rc = mls_context_to_sid(pol, oldc, p, ctx, sidtabp, def_sid);
-    orig_rc = mls_context_to_sid(orig_pol, orig_oldc, orig_p, orig_ctx, orig_sidtabp, def_sid);
-    if (rc) {
-        orig_rc = -EINVAL;
+    if (rc)
         goto out;
-    }
 
     /* Check the validity of the new context. */
-    orig_rc = rc = -EINVAL;
-    if (policydb_context_isvalid(pol, ctx)) {
+    rc = -EINVAL;
+    if (policydb_context_isvalid(pol, ctx))
         rc = 0;
-    }
-    if (policydb_context_isvalid(orig_pol, ctx)) {
-        orig_rc = 0;
-    }
 out:
     if (rc)
         context_destroy(ctx);
-    if (orig_rc)
-        context_destroy(orig_ctx);
-    *orig_rc_p = orig_rc;
     return rc;
 }
 
 static int security_context_to_sid_with_policy(struct selinux_policy *policy, const char *scontext, u32 scontext_len,
                                                u32 *sid, u32 def_sid, gfp_t gfp_flags, u32 *orig_sid_p, int *orig_rc_p)
 {
-    struct selinux_policy *orig_policy;
-    struct policydb *policydb, *orig_policydb;
-    struct sidtab *sidtab, *orig_sidtab;
-    char *scontext2, *scontext3, *str = NULL;
+    char stack_buf[256];
+    char *buf;
+    bool heap_alloc = false;
     struct context context, orig_context;
-    int rc = 0, orig_rc = 0;
-    u32 orig_sid;
+    int rc, orig_rc = -EINVAL;
+    u32 orig_sid = SECSID_NULL;
 
     /* An empty security context is never valid. */
     if (!scontext_len)
         return -EINVAL;
 
-    /* Copy the string to allow changes and ensure a NUL terminator */
-    scontext2 = kmemdup_nul(scontext, scontext_len, gfp_flags);
-    if (!scontext2)
-        return -ENOMEM;
-
-    scontext3 = kmemdup_nul(scontext, scontext_len, gfp_flags);
-    if (!scontext3) {
-        kfree(scontext2);
-        return -ENOMEM;
+    if (likely(scontext_len < sizeof(stack_buf))) {
+        buf = stack_buf;
+    } else {
+        buf = kmalloc(scontext_len + 1, gfp_flags);
+        if (!buf)
+            return -ENOMEM;
+        heap_alloc = true;
     }
+    memcpy(buf, scontext, scontext_len);
+    buf[scontext_len] = '\0';
 
-    // removed: if (!selinux_initialized())
     *sid = SECSID_NULL;
     if (orig_sid_p)
         *orig_sid_p = SECSID_NULL;
 
-    // removed: if (force)
     rcu_read_lock();
-    orig_policy = rcu_dereference(selinux_state.policy);
-    orig_policydb = &orig_policy->policydb;
-    orig_sidtab = orig_policy->sidtab;
-    policydb = &policy->policydb;
-    sidtab = policy->sidtab;
-    rc = string_to_context_struct(policydb, orig_policydb, sidtab, orig_sidtab, scontext2, scontext3, &context,
-                                  &orig_context, def_sid, &orig_rc);
+    rc = string_to_context_struct_single(&policy->policydb, policy->sidtab, buf, &context, def_sid);
     if (!rc) {
-        rc = sidtab_context_to_sid(sidtab, &context, sid);
-        // rc should not be frozen
+        rc = sidtab_context_to_sid(policy->sidtab, &context, sid);
         context_destroy(&context);
-        // removed: if (rc == -ESTALE)
-        if (!orig_rc) {
-            // sync to global sidtab
-            orig_rc = sidtab_context_to_sid(orig_sidtab, &orig_context, &orig_sid);
-            if (orig_sid_p)
-                *orig_sid_p = orig_sid;
-            context_destroy(&orig_context);
+        if (!rc && (orig_sid_p || orig_rc_p)) {
+            struct selinux_policy *orig_policy = rcu_dereference(selinux_state.policy);
+            memcpy(buf, scontext, scontext_len);
+            buf[scontext_len] = '\0';
+            orig_rc = string_to_context_struct_single(&orig_policy->policydb, orig_policy->sidtab, buf,
+                                                      &orig_context, def_sid);
+            if (!orig_rc) {
+                orig_rc = sidtab_context_to_sid(orig_policy->sidtab, &orig_context, &orig_sid);
+                if (!orig_rc && orig_sid_p)
+                    *orig_sid_p = orig_sid;
+                context_destroy(&orig_context);
+            }
         }
     }
     rcu_read_unlock();
+
     if (orig_rc_p)
         *orig_rc_p = orig_rc;
-    kfree(scontext3);
-    kfree(scontext2);
-    kfree(str);
+    if (unlikely(heap_alloc))
+        kfree(buf);
     return rc;
 }
 
-- 
2.34.1

