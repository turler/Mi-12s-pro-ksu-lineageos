+static inline bool susfs_is_vma_file_sus_map(struct file *f) {
+	struct inode *inode;
+	struct dentry *dentry;
+	const unsigned char *name;
+	unsigned int len;
+	bool match = false;
+	if (!f)
+		return false;
+	inode = file_inode(f);
+	if (SUSFS_IS_INODE_SUS_MAP(inode))
+		return true;
+	if (!inode || !susfs_is_current_untrusted_umounted_app() || __kuid_val(inode->i_uid) >= 10000)
+		return false;
+	dentry = f->f_path.dentry;
+	if (!dentry)
+		return false;
+	rcu_read_lock();
+	name = READ_ONCE(dentry->d_name.name);
+	len = READ_ONCE(dentry->d_name.len);
+	if (sb_rdonly(inode->i_sb))
+		match = unlikely(susfs_is_cusrom_name_len((const char *)name, len));
+	else
+		match = unlikely(susfs_is_cusrom_idmap_len((const char *)name, len));
+	rcu_read_unlock();
+	return match;
+}
 #endif // #if defined(CONFIG_KSU_SUSFS_SUS_MAP) || defined(CONFIG_KSU_SUSFS_OPEN_REDIRECT)
 
