diff --git a/kernel/feature/susfs_bridge.c b/kernel/feature/susfs_bridge.c
new file mode 100644
index 00000000..2220bff9
--- /dev/null
+++ b/kernel/feature/susfs_bridge.c
@@ -0,0 +1,395 @@
+#ifdef CONFIG_KSU_SUSFS
+
+#include <linux/cred.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/mount.h>
+#include <linux/namei.h>
+#include <linux/path.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/susfs.h>
+#include <linux/uaccess.h>
+
+#include "klog.h"
+#include "compat/kernel_compat.h"
+#include "policy/allowlist.h"
+#include "selinux/selinux.h"
+
+#define KSU_SUSFS_PRCTL_OPTION 0xDEADBEEF
+
+extern void ksu_try_umount_internal(const char *mnt, int flags);
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+extern bool susfs_is_mnt_devname_ksu(struct path *path);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+extern bool susfs_is_auto_add_sus_bind_mount_enabled;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+extern bool susfs_is_auto_add_sus_ksu_default_mount_enabled;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+extern bool susfs_is_auto_add_try_umount_for_bind_mount_enabled;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+extern void susfs_run_try_umount_for_current_mnt_ns(void);
+#endif
+
+bool susfs_is_current_ksu_domain(void)
+{
+	return is_ksu_domain();
+}
+EXPORT_SYMBOL(susfs_is_current_ksu_domain);
+
+bool susfs_is_current_zygote_domain(void)
+{
+	return is_zygote(current_cred());
+}
+EXPORT_SYMBOL(susfs_is_current_zygote_domain);
+
+bool susfs_is_allow_su(void)
+{
+	return ksu_is_allow_uid_for_current(current_uid().val);
+}
+EXPORT_SYMBOL(susfs_is_allow_su);
+
+void ksu_try_umount(const char *mnt, bool check_mnt, int flags, uid_t uid)
+{
+	struct path path;
+	int err = kern_path(mnt, 0, &path);
+	if (err)
+		return;
+	if (path.dentry != path.mnt->mnt_root) {
+		path_put(&path);
+		return;
+	}
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	if (check_mnt && !susfs_is_mnt_devname_ksu(&path)) {
+		path_put(&path);
+		return;
+	}
+#endif
+	path_put(&path);
+	ksu_try_umount_internal(mnt, flags);
+}
+EXPORT_SYMBOL(ksu_try_umount);
+
+void susfs_try_umount_all(uid_t uid)
+{
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	susfs_try_umount(uid);
+#endif
+	ksu_try_umount("/system", true, 0, uid);
+	ksu_try_umount("/system_ext", true, 0, uid);
+	ksu_try_umount("/vendor", true, 0, uid);
+	ksu_try_umount("/product", true, 0, uid);
+	ksu_try_umount("/odm", true, 0, uid);
+	ksu_try_umount("/data/adb/modules", false, MNT_DETACH, uid);
+}
+EXPORT_SYMBOL(susfs_try_umount_all);
+
+static bool susfs_file_exists(const char *p)
+{
+	struct path path;
+	if (!kern_path(p, LOOKUP_FOLLOW, &path)) {
+		path_put(&path);
+		return true;
+	}
+	return false;
+}
+
+void ksu_susfs_on_post_fs_data(void)
+{
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+	if (susfs_file_exists(DATA_ADB_NO_AUTO_ADD_SUS_BIND_MOUNT))
+		susfs_is_auto_add_sus_bind_mount_enabled = false;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+	if (susfs_file_exists(DATA_ADB_NO_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT))
+		susfs_is_auto_add_sus_ksu_default_mount_enabled = false;
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+	if (susfs_file_exists(DATA_ADB_NO_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT))
+		susfs_is_auto_add_try_umount_for_bind_mount_enabled = false;
+#endif
+}
+
+int ksu_susfs_task_prctl(int option, unsigned long arg2, unsigned long arg3,
+			 unsigned long arg4, unsigned long arg5)
+{
+	int error = 0;
+
+	if (option != KSU_SUSFS_PRCTL_OPTION)
+		return -ENOSYS;
+	if (current_uid().val != 0)
+		return -ENOSYS;
+
+	switch (arg2) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	case CMD_SUSFS_ADD_SUS_PATH:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_path)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_path((struct st_susfs_sus_path __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	case CMD_SUSFS_ADD_SUS_MOUNT:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_mount)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_mount((struct st_susfs_sus_mount __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_kstat)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_sus_kstat((struct st_susfs_sus_kstat __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_sus_kstat)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_update_sus_kstat((struct st_susfs_sus_kstat __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	case CMD_SUSFS_ADD_TRY_UMOUNT:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_try_umount)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_try_umount((struct st_susfs_try_umount __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+	case CMD_SUSFS_RUN_UMOUNT_FOR_CURRENT_MNT_NS:
+		susfs_run_try_umount_for_current_mnt_ns();
+		if (ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+				pr_info("susfs: copy_to_user failed\n");
+		}
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	case CMD_SUSFS_SET_UNAME:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_uname)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_uname((struct st_susfs_uname __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	case CMD_SUSFS_ENABLE_LOG:
+		if (arg3 != 0 && arg3 != 1)
+			error = -EINVAL;
+		else
+			susfs_set_log(arg3);
+		if (ksu_access_ok((void __user *)arg5, sizeof(error))) {
+			if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+				pr_info("susfs: copy_to_user failed\n");
+		}
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		if (!ksu_access_ok((void __user *)arg3, SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_set_cmdline_or_bootconfig((char __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		if (!ksu_access_ok((void __user *)arg3, sizeof(struct st_susfs_open_redirect)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = susfs_add_open_redirect((struct st_susfs_open_redirect __user *)arg3);
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+#endif
+	case CMD_SUSFS_SHOW_VERSION: {
+		const char *ver = SUSFS_VERSION;
+		size_t vlen = strlen(ver) + 1;
+		if (!ksu_access_ok((void __user *)arg3, vlen) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, ver, vlen) ? -EFAULT : 0;
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES: {
+		u64 feat = 0;
+		if (!ksu_access_ok((void __user *)arg3, sizeof(u64)) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+		feat |= (1ULL << 0);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+		feat |= (1ULL << 1);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+		feat |= (1ULL << 2);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+		feat |= (1ULL << 3);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+		feat |= (1ULL << 4);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_OVERLAYFS
+		feat |= (1ULL << 5);
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+		feat |= (1ULL << 6);
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+		feat |= (1ULL << 7);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+		feat |= (1ULL << 8);
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+		feat |= (1ULL << 9);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+		feat |= (1ULL << 10);
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+		feat |= (1ULL << 11);
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+		feat |= (1ULL << 12);
+#endif
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+		feat |= (1ULL << 14);
+#endif
+		error = copy_to_user((void __user *)arg3, &feat, sizeof(feat)) ? -EFAULT : 0;
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	case CMD_SUSFS_SHOW_VARIANT: {
+		const char *var = SUSFS_VARIANT;
+		size_t vlen = strlen(var) + 1;
+		if (!ksu_access_ok((void __user *)arg3, vlen) ||
+		    !ksu_access_ok((void __user *)arg5, sizeof(error)))
+			return 0;
+		error = copy_to_user((void __user *)arg3, var, vlen) ? -EFAULT : 0;
+		if (copy_to_user((void __user *)arg5, &error, sizeof(error)))
+			pr_info("susfs: copy_to_user failed\n");
+		return 0;
+	}
+	default:
+		return -ENOSYS;
+	}
+}
+
+struct st_susfs_reboot_ver {
+	char version[16];
+	int err;
+};
+struct st_susfs_reboot_var {
+	char variant[16];
+	int err;
+};
+struct st_susfs_reboot_feat {
+	char features[8192];
+	int err;
+};
+
+int ksu_susfs_handle_reboot(unsigned int cmd, void __user *arg)
+{
+	int err = 0;
+	if (!arg)
+		return 0;
+
+	if (cmd == CMD_SUSFS_SHOW_VERSION) {
+		struct st_susfs_reboot_ver __user *u = arg;
+		char v[16];
+		memset(v, 0, sizeof(v));
+		strlcpy(v, SUSFS_VERSION, sizeof(v));
+		err = copy_to_user(u->version, v, sizeof(v)) ? -EFAULT : 0;
+		copy_to_user(&u->err, &err, sizeof(err));
+		return 0;
+	}
+	if (cmd == CMD_SUSFS_SHOW_VARIANT) {
+		struct st_susfs_reboot_var __user *u = arg;
+		char v[16];
+		memset(v, 0, sizeof(v));
+		strlcpy(v, SUSFS_VARIANT, sizeof(v));
+		err = copy_to_user(u->variant, v, sizeof(v)) ? -EFAULT : 0;
+		copy_to_user(&u->err, &err, sizeof(err));
+		return 0;
+	}
+	if (cmd == CMD_SUSFS_SHOW_ENABLED_FEATURES) {
+		struct st_susfs_reboot_feat __user *u = arg;
+		const char *feat_str =
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+			"CONFIG_KSU_SUSFS_SUS_PATH\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+			"CONFIG_KSU_SUSFS_SUS_MOUNT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+			"CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+			"CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+			"CONFIG_KSU_SUSFS_SUS_KSTAT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+			"CONFIG_KSU_SUSFS_TRY_UMOUNT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+			"CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+			"CONFIG_KSU_SUSFS_SPOOF_UNAME\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+			"CONFIG_KSU_SUSFS_ENABLE_LOG\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS
+			"CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+			"CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+			"CONFIG_KSU_SUSFS_OPEN_REDIRECT\n"
+#endif
+#ifdef CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT
+			"CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT\n"
+#endif
+			"";
+		size_t flen = strlen(feat_str) + 1;
+		if (flen > 8192) flen = 8192;
+		err = copy_to_user(u->features, feat_str, flen) ? -EFAULT : 0;
+		copy_to_user(&u->err, &err, sizeof(err));
+		return 0;
+	}
+	return 0;
+}
+
+#endif
