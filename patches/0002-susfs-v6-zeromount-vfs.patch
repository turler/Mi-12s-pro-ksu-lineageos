+		return true;
+	if (unlikely(len == 19 && !memcmp(name, "atrace_userdebug.rc", 19)))
+		return true;
+	for (i = 0; i <= len - 7; i++) {
+		if (((name[i]   | 0x20) == 'l') &&
+		    ((name[i+1] | 0x20) == 'i') &&
+		    ((name[i+2] | 0x20) == 'n') &&
+		    ((name[i+3] | 0x20) == 'e') &&
+		    ((name[i+4] | 0x20) == 'a') &&
+		    ((name[i+5] | 0x20) == 'g') &&
