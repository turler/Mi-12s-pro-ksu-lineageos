+	bitmap_zero(zm_bloom, ZM_BLOOM_BITS);
+	list_for_each_entry(rule, &zeromount_rules_list, list) {
+		u32 h = full_name_hash(NULL, rule->virtual_path, rule->vp_len);
+		zm_bloom_add(h);
+		count++;
