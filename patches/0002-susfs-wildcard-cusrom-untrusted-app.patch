index 432f596d6..a41d33d1f 100644
--- a/include/linux/susfs_def.h
+++ b/include/linux/susfs_def.h
@@ -66,6 +66,7 @@
 #define TIF_PROC_UMOUNTED 33
 #define TIF_PROC_NO_SU 34
 #define TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT 35
+#define TIF_PROC_UNTRUSTED_APP 36
 
 #define AS_FLAGS_SUS_PATH 33
 #define AS_FLAGS_SUS_MOUNT 34
@@ -161,6 +162,37 @@ static inline void susfs_clear_current_proc_no_su(void) {
 	clear_thread_flag(TIF_PROC_NO_SU);
 }
 
+static inline bool susfs_is_current_untrusted_umounted_app(void) {
+	return (likely(test_thread_flag(TIF_PROC_UMOUNTED)) &&
+			likely(test_thread_flag(TIF_PROC_UNTRUSTED_APP)) &&
+			current_uid().val >= 10000);
+}
+
+static inline bool susfs_is_cusrom_name_len(const char *name, int len) {
+	int i;
+	if (unlikely(!name || len < 7))
+		return false;
+	if (unlikely(len == 7 && !memcmp(name, "addon.d", 7)))
+		return true;
+	for (i = 0; i <= len - 7; i++) {
+		if (((name[i]   | 0x20) == 'l') &&
+		    ((name[i+1] | 0x20) == 'i') &&
+		    ((name[i+2] | 0x20) == 'n') &&
+		    ((name[i+3] | 0x20) == 'e') &&
+		    ((name[i+4] | 0x20) == 'a') &&
+		    ((name[i+5] | 0x20) == 'g') &&
+		    ((name[i+6] | 0x20) == 'e'))
+			return true;
+	}
+	return false;
+}
+
+static inline bool susfs_is_cusrom_idmap_len(const char *name, int len) {
+	return (len > 13 &&
+		!memcmp(name + len - 6, "@idmap", 6) &&
+		susfs_is_cusrom_name_len(name, len));
+}
+
 #define SUSFS_IS_INODE_SUS_MAP(inode) \
