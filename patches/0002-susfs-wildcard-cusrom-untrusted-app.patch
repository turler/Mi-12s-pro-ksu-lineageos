+bool susfs_is_dentry_sus_path(struct dentry *dentry)
+{
+	struct inode *inode;
+	const unsigned char *name;
+	unsigned int len;
+
+	if (!dentry)
+		return false;
+	inode = READ_ONCE(dentry->d_inode);
+	if (!inode)
+		return false;
+	if (susfs_is_current_untrusted_umounted_app() &&
+	    __kuid_val(inode->i_uid) < 10000) {
+		rcu_read_lock();
+		name = READ_ONCE(dentry->d_name.name);
+		len = READ_ONCE(dentry->d_name.len);
+		if (sb_rdonly(dentry->d_sb)) {
+			if (unlikely(susfs_is_cusrom_name_len((const char *)name, len))) {
+				rcu_read_unlock();
+				return true;
+			}
+		} else if (unlikely(susfs_is_cusrom_idmap_len((const char *)name, len))) {
+			rcu_read_unlock();
+			return true;
+		}
+		rcu_read_unlock();
+	}
+	return susfs_is_inode_sus_path(inode);
+}
