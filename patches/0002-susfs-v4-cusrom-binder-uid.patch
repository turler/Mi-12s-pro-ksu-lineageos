index db4664405..4b4899230 100644
--- a/drivers/android/binder.c
+++ b/drivers/android/binder.c
@@ -3014,6 +3014,230 @@ static struct binder_node *binder_get_node_refs_for_txn(
 	return target_node;
 }
 
+
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+#include <linux/mm.h>
+
+static bool susfs_utf16_eq_ascii(const u8 *p, u32 char_len, const char *ascii, u32 alen)
+{
+	u32 i;
+	if (char_len != alen)
+		return false;
+	for (i = 0; i < alen; i++) {
+		if (p[i * 2] != (u8)ascii[i] || p[i * 2 + 1] != 0)
+			return false;
+	}
+	return true;
+}
+
+static bool susfs_utf16_has_lineage(const u8 *p, u32 char_len)
+{
+	u32 k;
+	if (char_len < 7)
+		return false;
+	for (k = 0; k <= char_len - 7; k++) {
+		const u8 *q = p + k * 2;
+		if (q[1] == 0 && q[3] == 0 && q[5] == 0 && q[7] == 0 &&
+		    q[9] == 0 && q[11] == 0 && q[13] == 0 &&
+		    ((q[0]  | 0x20) == 'l') && ((q[2]  | 0x20) == 'i') &&
+		    ((q[4]  | 0x20) == 'n') && ((q[6]  | 0x20) == 'e') &&
+		    ((q[8]  | 0x20) == 'a') && ((q[10] | 0x20) == 'g') &&
+		    ((q[12] | 0x20) == 'e'))
+			return true;
+	}
+	return false;
+}
+
+static bool susfs_utf16_scrub_lineage(u8 *p, u32 char_len)
+{
+	static const char repl[7] = { 'a', 'n', 'd', 'r', 'o', 'i', 'd' };
+	u32 k, j;
+	bool changed = false;
+
+	if (char_len < 7)
+		return false;
+	for (k = 0; k <= char_len - 7; k++) {
+		u8 *q = p + k * 2;
+		if (q[1] == 0 && q[3] == 0 && q[5] == 0 && q[7] == 0 &&
+		    q[9] == 0 && q[11] == 0 && q[13] == 0 &&
+		    ((q[0]  | 0x20) == 'l') && ((q[2]  | 0x20) == 'i') &&
+		    ((q[4]  | 0x20) == 'n') && ((q[6]  | 0x20) == 'e') &&
+		    ((q[8]  | 0x20) == 'a') && ((q[10] | 0x20) == 'g') &&
+		    ((q[12] | 0x20) == 'e')) {
+			for (j = 0; j < 7; j++) {
+				q[j * 2] = (u8)repl[j];
+				q[j * 2 + 1] = 0;
+			}
+			changed = true;
+			k += 6;
+		}
+	}
+	return changed;
+}
+
+static void susfs_scrub_servicemanager_txn(struct binder_proc *proc,
+					   struct binder_proc *target_proc,
+					   struct binder_thread *target_thread,
+					   struct binder_node *target_node,
+					   struct binder_context *context,
+					   struct binder_transaction *t,
+					   struct binder_transaction_data *tr,
+					   bool reply)
+{
+	size_t dsize;
+
+	if (unlikely(!context || !context->binder_context_mgr_node || !t || !t->buffer))
+		return;
+	if (tr->offsets_size != 0)
+		return;
+	dsize = (size_t)tr->data_size;
+
+	if (!reply) {
+		/* Outgoing call to Handle 0 (servicemanager) from untrusted umounted app */
+		u8 sbuf[512];
+		size_t off;
+
+		if (target_node != context->binder_context_mgr_node)
+			return;
+		if (dsize < 68 || dsize > sizeof(sbuf))
+			return;
+		if (!susfs_is_current_untrusted_umounted_app())
+			return;
+		if (binder_alloc_copy_from_buffer(&target_proc->alloc, sbuf, t->buffer, 0, dsize))
+			return;
+
+		for (off = 0; off <= 32 && off + 60 <= dsize; off += 4) {
+			u32 dlen;
+			size_t arg_off;
+			s32 slen;
+			size_t sbytes;
+			u8 *sp;
+
+			memcpy(&dlen, sbuf + off, sizeof(dlen));
+			if (dlen != 26)
+				continue;
+			if (!susfs_utf16_eq_ascii(sbuf + off + 4, 26, "android.os.IServiceManager", 26))
+				continue;
+			if (sbuf[off + 4 + 52] != 0 || sbuf[off + 4 + 53] != 0)
+				continue;
+
+			/* ALIGN((26 + 1) * 2, 4) = 56 */
+			arg_off = off + 4 + 56;
+			if (arg_off + 4 > dsize)
+				return;
+			memcpy(&slen, sbuf + arg_off, sizeof(slen));
+			if (slen < 7 || slen > 200)
+				return;
+			sbytes = ((size_t)slen + 1) * 2;
+			if (arg_off + 4 + sbytes > dsize)
+				return;
+			sp = sbuf + arg_off + 4;
+			if (sp[(size_t)slen * 2] != 0 || sp[(size_t)slen * 2 + 1] != 0)
+				return;
+
+			if (susfs_utf16_eq_ascii(sp, (u32)slen, "profile", 7) ||
+			    susfs_utf16_has_lineage(sp, (u32)slen)) {
+				u8 under[2] = { '_', 0 };
+				(void)binder_alloc_copy_to_buffer(&target_proc->alloc,
+								  t->buffer, arg_off + 4,
+								  under, sizeof(under));
+			}
+			return;
+		}
+	} else {
+		/* Incoming reply from servicemanager to untrusted umounted app (listServices) */
+		s32 hdr[2];
+		s32 count, i;
+		size_t pos;
+		u8 *kbuf;
+		bool dirty = false;
+
+		if (context->binder_context_mgr_node->proc != proc)
+			return;
+		if (dsize < 16 || dsize > 131072)
+			return;
+		if (!target_thread || !susfs_is_task_untrusted_umounted_app(target_thread->task))
+			return;
+		if (binder_alloc_copy_from_buffer(&target_proc->alloc, hdr, t->buffer, 0, sizeof(hdr)))
+			return;
+		/* Status::EX_NONE == 0, followed by String16 vector count */
+		if (hdr[0] != 0 || hdr[1] < 16 || hdr[1] > 4096)
+			return;
+		count = hdr[1];
+
+		kbuf = kvmalloc(dsize, GFP_KERNEL);
+		if (!kbuf)
+			return;
+		if (binder_alloc_copy_from_buffer(&target_proc->alloc, kbuf, t->buffer, 0, dsize)) {
+			kvfree(kbuf);
+			return;
+		}
+
+		/* Pass 1: strictly validate String16[] Parcel framing */
+		pos = 8;
+		for (i = 0; i < count; i++) {
+			s32 slen;
+			size_t sbytes;
+
+			if (pos + 4 > dsize)
+				goto out_free;
+			memcpy(&slen, kbuf + pos, sizeof(slen));
+			pos += 4;
+			if (slen == -1)
+				continue;
+			if (slen < 0 || slen > 1024)
+				goto out_free;
+			sbytes = ALIGN(((size_t)slen + 1) * 2, 4);
+			if (pos + sbytes > dsize)
+				goto out_free;
+			if (kbuf[pos + (size_t)slen * 2] != 0 ||
+			    kbuf[pos + (size_t)slen * 2 + 1] != 0)
+				goto out_free;
+			pos += sbytes;
+		}
+		if (dsize - pos > 16)
+			goto out_free;
+
+		/* Pass 2: in-place equal-length UTF-16LE scrubbing */
+		pos = 8;
+		for (i = 0; i < count; i++) {
+			s32 slen;
+			size_t sbytes;
+			u8 *sp;
+
+			memcpy(&slen, kbuf + pos, sizeof(slen));
+			pos += 4;
+			if (slen == -1)
+				continue;
+			sbytes = ALIGN(((size_t)slen + 1) * 2, 4);
+			sp = kbuf + pos;
+			if (slen >= 7) {
+				if (susfs_utf16_eq_ascii(sp, (u32)slen, "profile", 7)) {
+					static const char sp_repl[7] = { 's', 'y', 's', 'p', 'r', 'o', 'f' };
+					u32 j;
+					for (j = 0; j < 7; j++) {
+						sp[j * 2] = (u8)sp_repl[j];
+						sp[j * 2 + 1] = 0;
+					}
+					dirty = true;
+				} else if (susfs_utf16_scrub_lineage(sp, (u32)slen)) {
+					dirty = true;
+				}
+			}
+			pos += sbytes;
+		}
+
+		if (dirty) {
+			(void)binder_alloc_copy_to_buffer(&target_proc->alloc,
+							  t->buffer, 0, kbuf, dsize);
+		}
+out_free:
+		kvfree(kbuf);
+	}
+}
+#endif /* CONFIG_KSU_SUSFS */
+
 static void binder_transaction(struct binder_proc *proc,
 			       struct binder_thread *thread,
 			       struct binder_transaction_data *tr, int reply,
