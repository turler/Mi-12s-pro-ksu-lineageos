+static inline bool susfs_is_current_untrusted_umounted_app(void) {
+	return (likely(test_thread_flag(TIF_PROC_UMOUNTED)) &&
+		likely(test_thread_flag(TIF_PROC_UNTRUSTED_APP)) &&
+		((current_uid().val % 100000) >= 10000));
+}
+
+static inline bool susfs_is_task_untrusted_umounted_app(struct task_struct *task) {
+	if (unlikely(!task))
+		return false;
+	return (test_ti_thread_flag(task_thread_info(task), TIF_PROC_UMOUNTED) &&
+		test_ti_thread_flag(task_thread_info(task), TIF_PROC_UNTRUSTED_APP) &&
+		((__kuid_val(task_uid(task)) % 100000) >= 10000));
+}
+
+static inline bool susfs_is_untrusted_secctx(const char *str, size_t size) {
+	if (!str || !size)
+		return false;
+	return ((size >= 17 && !memcmp(str, "u:r:untrusted_app", 17)) ||
+		(size >= 16 && !memcmp(str, "u:r:isolated_app", 16)));
+}
+
+static inline bool susfs_is_cusrom_name_len(const char *name, int len) {
+	int i;
+	if (unlikely(!name || len < 7))
+		return false;
+	if (unlikely(len == 7 && !memcmp(name, "addon.d", 7)))
+		return true;
+	if (unlikely(len == 13 && !memcmp(name, "init-debug.rc", 13)))
+		return true;
+	if (unlikely(len == 14 && !memcmp(name, "gps_debug.conf", 14)))
+		return true;
+	if (unlikely(len == 17 && (!memcmp(name, "bootstat-debug.rc", 17) ||
+				   !memcmp(name, "qmipriod.debug.rc", 17))))
+		return true;
+	if (unlikely(len == 19 && !memcmp(name, "atrace_userdebug.rc", 19)))
+		return true;
+	for (i = 0; i <= len - 7; i++) {
+		if (((name[i]   | 0x20) == 'l') &&
+		    ((name[i+1] | 0x20) == 'i') &&
+		    ((name[i+2] | 0x20) == 'n') &&
+		    ((name[i+3] | 0x20) == 'e') &&
+		    ((name[i+4] | 0x20) == 'a') &&
+		    ((name[i+5] | 0x20) == 'g') &&
+		    ((name[i+6] | 0x20) == 'e'))
+			return true;
+	}
+	return false;
+}
+
+static inline bool susfs_is_cusrom_idmap_len(const char *name, int len) {
+	return (len > 13 &&
+		!memcmp(name + len - 6, "@idmap", 6) &&
+		susfs_is_cusrom_name_len(name, len));
+}
